   "source": [
    "import pandas as pd\n",
    "\n",
    "df = pd.read_csv('ecommerce_sales.csv')\n",
    "\n",
    "cat = df.groupby(\"category\")[\"revenue\"].sum().sort_values(ascending=False).head(3)\n",
    "\n",
    "#print(cat)\n",
    "print(\"The top 3 categories by revenue are:\\n\", cat)"
   ]
